        "import gymnasium as gym\n",
        "import numpy as np\n",
        "\n",
        "# --- Task 1: Create the MountainCar environment ---\n",
        "env = gym.make('MountainCar-v0')\n",
        "print(\"Environmnet created\")\n",
        "\n",
        "# --- Task 2: Reset the environment and display the initial state ---\n",
        "state, info = env.reset()\n",
        "print(f\"Car Position: {state[0]:.6f}\")\n",
        "print(f\"Car Velocity: {state[1]:.1f}\")\n",
        "\n",
        "# --- Task 3: Identify the action space and available actions ---\n",
        "action_space = env.action_space\n",
        "print(action_space)\n",
        "\n",
        "# Action description mapper\n",
        "action_descriptions = {\n",
        "    0: \"Accelerate left direction\",\n",
        "    1: \"No Accelerate\",\n",
        "    2: \"Accelerate right direction\"\n",
        "}\n",
        "\n",
        "# Randomly select an action and display its description\n",
        "random_action = action_space.sample()\n",
        "print(action_descriptions[random_action])\n",
        "\n",
        "# --- Task 4: Execute one random action and display the transition ---\n",
        "current_state = state\n",
        "next_state, reward, terminated, truncated, info = env.step(random_action)\n",
        "\n",
        "print(f\"current_state= {current_state}\")\n",
        "print(f\"next_state= {next_state}\")\n",
        "print(f\"reward= {reward}\")\n",
        "print(f\"terminated= {terminated}\")\n",
        "print(f\"truncated= {truncated}\")\n",
        "\n",
        "# --- Task 5: Run the random agent for up to 100 steps and calculate rewards ---\n",
        "# Resetting environment as per the guidelines to begin a fresh 100-step loop\n",
        "state, info = env.reset()\n",
        "total_reward = 0.0\n",
        "max_steps = 100\n",
        "steps_taken = 0\n",
        "\n",
        "for episode in range(1, max_steps + 1):\n",
        "    current_state = state\n",
        "    action = env.action_space.sample()\n",
        "    state, reward, terminated, truncated, info = env.step(action)\n",
        "    total_reward += reward\n",
        "    steps_taken += 1\n",
        "\n",
        "    print(f\"episode={episode} | next_state={state} | current_state={current_state} | reward={reward} | teminated={terminated}\")\n",
        "\n",
        "    if terminated or truncated:\n",
        "        break\n",
        "\n",
        "average_reward = total_reward / steps_taken\n",
        "print(f\"total_reward={total_reward}\")\n",
        "print(f\"average_reward={average_reward}\")\n",
        "\n",
        "env.close()"
      ],
